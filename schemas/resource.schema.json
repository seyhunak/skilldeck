{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seyhunak/skilldeck/schemas/resource.schema.json",
  "title": "Skilldeck Resource Manifest",
  "description": "Manifest for one Skilldeck resource package. schema_version 1.0 manifests remain valid; 1.1 adds purpose, dates, relationships, and featured status.",
  "type": "object",
  "required": ["schema_version", "id", "name", "type", "description", "version", "author", "license", "domain", "use_cases", "tags", "content", "compatibility", "status"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 64},
    "name": {"type": "string", "minLength": 3, "maxLength": 80},
    "type": {"enum": ["agent", "skill", "prompt", "routine", "instruction"]},
    "description": {"type": "string", "minLength": 30, "maxLength": 300},
    "purpose": {"type": "string", "minLength": 60, "maxLength": 800},
    "version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"},
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 2},
        "github": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"},
        "url": {"type": "string", "pattern": "^https://"}
      },
      "additionalProperties": false
    },
    "license": {"type": "string", "minLength": 2},
    "domain": {"type": "string"},
    "use_cases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "tags": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "content": {
      "type": "object",
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": {"type": "string"},
        "files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "level"],
        "properties": {
          "platform": {"type": "string"},
          "level": {"enum": ["native_install", "native_import", "file_export", "copy_paste", "generic_export", "not_supported", "unverified"]},
          "resource_types": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"},
          "verified_on": {"type": "string"},
          "evidence_url": {"type": "string", "pattern": "^https://"}
        },
        "additionalProperties": false
      }
    },
    "requirements": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "related": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "featured": {"type": "boolean"},
    "safety": {
      "type": "object",
      "required": ["contains_scripts", "network_access", "handles_sensitive_data"],
      "properties": {
        "contains_scripts": {"type": "boolean"},
        "network_access": {"type": "boolean"},
        "handles_sensitive_data": {"type": "boolean"},
        "professional_advice_disclaimer": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["submitted", "approved", "deprecated"]},
    "tested": {"type": "boolean"},
    "tested_with": {"type": "array", "items": {"type": "string"}},
    "changelog": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}},
      "then": {"required": ["purpose", "created", "updated", "safety", "dependencies", "related"]}
    }
  ],
  "additionalProperties": false
}
