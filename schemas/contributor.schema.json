{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skilldeck Contributor Profile",
  "type": "object",
  "required": ["schema_version", "github"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "github": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "bio": {"type": "string", "maxLength": 400},
    "website": {"type": "string", "pattern": "^https://"},
    "location": {"type": "string", "maxLength": 80},
    "social_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {"label": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"}},
        "additionalProperties": false
      }
    },
    "featured_resource_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
