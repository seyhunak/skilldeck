{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skilldeck Curated Collections",
  "type": "object",
  "required": ["schema_version", "collections"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "audience", "use_cases", "resources", "symbol", "accent"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 3},
          "description": {"type": "string", "minLength": 40},
          "audience": {"type": "string", "minLength": 10},
          "use_cases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "symbol": {"type": "string"},
          "accent": {"enum": ["blue", "purple", "pink", "red", "orange", "yellow", "green", "mint", "teal", "cyan", "indigo", "brown", "gray"]},
          "featured": {"type": "boolean"},
          "resources": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {"id": {"type": "string"}, "step": {"type": "integer", "minimum": 1}, "note": {"type": "string"}},
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
